---
/**
 * Sayfanın arkasındaki derin deniz: yavaşça süzülen "deniz karı" parçacıkları
 * ve biyolüminesans ışıklar. Aşağı kaydırdıkça su koyulaşır (--page-p).
 * Yalnızca CSS; parçacıklar GPU'da taşınan katmanlar olduğu için hafiftir.
 */
---
<div class="ocean" aria-hidden="true">
  <div class="ocean__glow ocean__glow--a"></div>
  <div class="ocean__glow ocean__glow--b"></div>
  <div class="ocean__glow ocean__glow--c"></div>
  <div class="ocean__snow ocean__snow--far"></div>
  <div class="ocean__snow ocean__snow--near"></div>
  <div class="ocean__dark"></div>
</div>

<style>
  .ocean {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(120% 70% at 50% -10%, #17245c 0%, rgba(23, 36, 92, 0) 60%),
      linear-gradient(180deg, #0b1540 0%, #08103a 45%, #050920 100%);
  }

  .ocean__glow {
    position: absolute;
    width: 60vmax;
    height: 60vmax;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.32;
    will-change: transform;
  }
  .ocean__glow--a {
    top: -20vmax;
    left: -18vmax;
    background: radial-gradient(circle, rgba(124, 92, 245, 0.55), transparent 65%);
    animation: drift-a 28s var(--ease-in-out) infinite alternate;
  }
  .ocean__glow--b {
    bottom: -26vmax;
    right: -20vmax;
    background: radial-gradient(circle, rgba(79, 140, 255, 0.4), transparent 65%);
    animation: drift-b 34s var(--ease-in-out) infinite alternate;
  }
  .ocean__glow--c {
    top: 30%;
    left: 40%;
    width: 36vmax;
    height: 36vmax;
    background: radial-gradient(circle, rgba(242, 196, 90, 0.14), transparent 65%);
    animation: drift-c 40s var(--ease-in-out) infinite alternate;
  }

  /* Deniz karı: döşenmiş nokta deseni, iki katman farklı hızda yukarı akar. */
  .ocean__snow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 200%;
    will-change: transform;
  }
  .ocean__snow--far {
    background-image:
      radial-gradient(1px 1px at 20px 30px, rgba(200, 210, 255, 0.5), transparent 60%),
      radial-gradient(1px 1px at 140px 90px, rgba(200, 210, 255, 0.35), transparent 60%),
      radial-gradient(1.2px 1.2px at 260px 210px, rgba(200, 210, 255, 0.45), transparent 60%),
      radial-gradient(1px 1px at 90px 260px, rgba(200, 210, 255, 0.3), transparent 60%),
      radial-gradient(1px 1px at 320px 40px, rgba(200, 210, 255, 0.4), transparent 60%);
    background-size: 360px 300px;
    opacity: 0.7;
    animation: snow 90s linear infinite;
  }
  .ocean__snow--near {
    background-image:
      radial-gradient(1.8px 1.8px at 60px 80px, rgba(220, 225, 255, 0.55), transparent 60%),
      radial-gradient(1.4px 1.4px at 420px 160px, rgba(220, 225, 255, 0.4), transparent 60%),
      radial-gradient(2px 2px at 250px 380px, rgba(220, 225, 255, 0.45), transparent 60%),
      radial-gradient(1.5px 1.5px at 520px 420px, rgba(220, 225, 255, 0.35), transparent 60%);
    background-size: 600px 500px;
    opacity: 0.6;
    animation: snow 60s linear infinite;
  }

  .ocean__dark {
    position: absolute;
    inset: 0;
    background: #02040f;
    opacity: calc(var(--page-p) * 0.55);
  }

  @keyframes snow {
    to { transform: translate3d(0, -50%, 0); }
  }
  @keyframes drift-a {
    to { transform: translate3d(14vw, 10vh, 0) scale(1.15); }
  }
  @keyframes drift-b {
    to { transform: translate3d(-12vw, -14vh, 0) scale(1.1); }
  }
  @keyframes drift-c {
    to { transform: translate3d(-20vw, 18vh, 0) scale(1.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ocean__glow,
    .ocean__snow {
      animation: none;
    }
  }
</style>
