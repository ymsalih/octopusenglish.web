---
/**
 * "Neden bir ahtapot?" cümlesi. Bölüm ekrana girince (data-reveal → .is-visible)
 * kelimeler soldan sağa, kısa aralıklarla kendiliğinden belirir; kaydırmaya
 * bağlı değildir, tek kaydırmada tamamı görünür.
 * [[ ]] içindeki ifadeler altın, {{ }} içindekiler mor vurgulanır.
 */
const text =
  'Bir ahtapotun [[sekiz kolu,]] [[üç kalbi]] ve [[dokuz beyni]] vardır. İngilizce öğrenmek için hepsine ihtiyacın yok: {{Octopus English}} kelimeleri yakalar, kartlarla tekrar ettirir, sesli okutup telaffuzunu dinler ve her gün biraz daha derine götürür.';

type Word = { text: string; tone?: 'gold' | 'violet' };
const words: Word[] = [];
for (const part of text.split(/(\[\[.*?\]\]|\{\{.*?\}\})/)) {
  if (!part) continue;
  const tone = part.startsWith('[[') ? 'gold' : part.startsWith('{{') ? 'violet' : undefined;
  const clean = tone ? part.slice(2, -2) : part;
  for (const w of clean.split(/\s+/).filter(Boolean)) words.push({ text: w, tone });
}
---
<section class="manifesto section" id="manifesto" aria-label="Neden Octopus English">
  <div class="container">
    <p class="kicker" data-reveal>Neden bir ahtapot?</p>
    <p class="manifesto__text" data-reveal="none">
      {words.map((w, i) => (
        <span class:list={['w', w.tone && `w--${w.tone}`]} style={`--i:${i}`}>{w.text} </span>
      ))}
    </p>
  </div>
</section>

<style>
  .manifesto__text {
    margin-top: 22px;
    max-width: 30ch;
    font: 600 clamp(1.45rem, 3.4vw, 2.75rem) / 1.25 var(--font-display);
    letter-spacing: -0.01em;
  }
  .w {
    display: inline-block;
    white-space: pre;
  }
  .w--gold {
    color: var(--accent);
    text-shadow: 0 0 28px rgba(242, 196, 90, 0.35);
  }
  .w--violet {
    color: var(--primary-light);
    text-shadow: 0 0 28px rgba(169, 150, 255, 0.4);
  }

  /* Ekrana girince kelimeler 30 ms arayla belirir (~40 kelime ≈ 1,5 sn).
     JS yoksa ya da hareket azaltma açıksa metin baştan tam görünür. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .w {
      opacity: 0.12;
      transform: translateY(0.35em);
      filter: blur(4px);
    }
    .manifesto__text:global(.is-visible) .w {
      animation: word-in 0.7s var(--ease-out) both;
      animation-delay: calc(var(--i) * 30ms);
    }
  }
  @keyframes word-in {
    from {
      opacity: 0.12;
      transform: translateY(0.35em);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
