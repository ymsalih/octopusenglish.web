---
/**
 * Özellikler: masaüstünde telefon sağda yapışkan durur, soldaki adımlar
 * kaydıkça telefondaki ekran değişir. Mobilde her adımın kendi telefonu var.
 * Aktif adımı scripts/motion.ts belirler (data-steps / data-step / data-screen).
 */
import Icon from '../Icon.astro';
import Phone from '../phone/Phone.astro';
import WordsScreen from '../phone/screens/WordsScreen.astro';
import TestScreen from '../phone/screens/TestScreen.astro';
import ChatScreen from '../phone/screens/ChatScreen.astro';
import StoryScreen from '../phone/screens/StoryScreen.astro';
import TranslateScreen from '../phone/screens/TranslateScreen.astro';
import SpeakScreen from '../phone/screens/SpeakScreen.astro';

const steps = [
  {
    id: 'words',
    Screen: WordsScreen,
    icon: 'style-rounded',
    kicker: 'Kelime Havuzu',
    title: 'Kendi sözlüğünü kur.',
    text: 'Bilmediğin kelimeyi İngilizce ya da Türkçe yaz, karşılığı otomatik gelsin. Havuzunda ara, telaffuzunu dinle, gereksizleri kaydırarak sil.',
    chips: ['Otomatik çeviri', 'İki yönlü', 'Sesli telaffuz'],
    label: 'Kelime Havuzum ekranı: yeni kelime ekleniyor',
  },
  {
    id: 'test',
    Screen: TestScreen,
    icon: 'quiz-rounded',
    kicker: 'Kendini Test Et',
    title: 'Kaydır, hatırla, kalıcı öğren.',
    text: 'Kartı çevir; hatırladıysan sola, unuttuysan sağa, tamamen öğrendiysen yukarı kaydır. En uzun süredir tekrar etmediğin kelimeler önce gelir, testin sonunda başarı oranını görürsün.',
    chips: ['Akıllı tekrar sırası', '10 · 20 · 50 kelime', 'Sonuç raporu'],
    label: 'Kelime testi ekranı: kartlar kaydırılıyor',
  },
  {
    id: 'chat',
    Screen: ChatScreen,
    icon: 'forum-rounded',
    kicker: 'Octopus AI',
    title: 'Hatalarından korkmadan konuş.',
    text: 'Yapay zeka öğretmeninle seviyene uygun İngilizce sohbet et. Bir gramer hatası yaptığında doğrusunu Türkçe açıklamasıyla hemen gösterir; her cevabı dinleyebilir, tek dokunuşla çevirebilirsin.',
    chips: ['Serbest', 'Gramer', 'Kelime', 'Günlük', 'İş', 'Seyahat'],
    chipsLabel: '6 sohbet modu',
    label: 'Octopus AI sohbet ekranı: gramer düzeltmesi gösteriliyor',
  },
  {
    id: 'story',
    Screen: StoryScreen,
    icon: 'auto-stories-rounded',
    kicker: 'Etkileşimli Hikayeler',
    title: 'Hikayenin kahramanı sen ol.',
    text: 'Macera, Gizem, Bilim Kurgu, Günlük Yaşam ya da Fantastik. Her bölümün sonunda gidişata sen karar verirsin; bilmediğin kelimeye dokununca çevirisi açılır. Hikaye bitince okuma anlama testi seni bekler.',
    chips: ['5 tür', 'A1–C2', '3 bölüm + test'],
    label: 'Etkileşimli hikaye ekranı: kelime çevirisi ve seçim',
  },
  {
    id: 'translate',
    Screen: TranslateScreen,
    icon: 'photo-camera-rounded',
    kicker: 'Akıllı Çeviri',
    title: 'Etrafındaki İngilizceyi yakala.',
    text: 'Bir tabelayı, menüyü ya da kitap sayfasını kamerayla tara; metin telefonunda okunur. Çevirinin yanında sözcük türü, bağlam içinde örnek cümleler ve kelimeye uygun bir görsel gelir.',
    chips: ['Kamera ve galeri', 'Sesle yazma', 'Örnek cümleler'],
    label: 'Kamerayla tarama ve akıllı çeviri ekranı',
  },
  {
    id: 'speak',
    Screen: SpeakScreen,
    icon: 'mic-rounded',
    kicker: 'Okuma & Telaffuz',
    title: 'Sesli oku, anında puanını gör.',
    text: 'Seviyene uygun bir metni sesli oku. Doğru okuduğun kelimeler yeşile, tekrar etmen gerekenler kırmızıya döner; kırmızı kelimeye dokunup doğrusunu dinle.',
    chips: ['7 kategori', 'A1–C2', 'Kelime kelime geri bildirim'],
    label: 'Telaffuz ekranı: kelimeler doğru ve yanlış olarak işaretleniyor',
  },
];
---
<section class="features section" id="ozellikler" aria-labelledby="features-title">
  <div class="container features__head">
    <p class="kicker" data-reveal>Özellikler</p>
    <h2 id="features-title" class="title-lg" data-reveal style="--d:0.08s">
      Öğrenmenin her hali, <span class="text-violet">tek uygulamada.</span>
    </h2>
    <p class="lead" data-reveal style="--d:0.16s">
      Kelime havuzundan yapay zeka sohbetine, uygulamanın kalbindeki altı özelliği ekran ekran keşfet.
    </p>
  </div>

  <div class="story container" data-steps>
    <div class="story__steps">
      {steps.map((s, i) => (
        <article class="step" data-step={s.id} id={`ozellik-${s.id}`}>
          <div class="step__text">
            <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p class="step__kicker">
              <Icon name={s.icon} /> {s.kicker}
            </p>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.text}</p>
            {s.chipsLabel && <p class="step__chips-label">{s.chipsLabel}</p>}
            <ul class="step__chips">
              {s.chips.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div class="step__phone">
            <Phone label={s.label}>
              <s.Screen inline />
            </Phone>
          </div>
        </article>
      ))}
    </div>

    <div class="story__visual" aria-hidden="true">
      <div class="story__sticky">
        <div class="story__glow"></div>
        <Phone class="story__phone">
          {steps.map((s) => <s.Screen />)}
        </Phone>
        <ol class="story__dots">
          {steps.map((s, i) => (
            <li data-dot={s.id}>
              <a href={`#ozellik-${s.id}`} tabindex="-1"><span>{String(i + 1).padStart(2, '0')}</span></a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  @property --glow {
    syntax: '<color>';
    inherits: true;
    initial-value: rgba(124, 92, 245, 0.55);
  }

  .features {
    padding-bottom: 40px;
    /* Telefonların arkasındaki parıltı ekran dışına taşmasın. "clip" kaydırma
       kutusu oluşturmaz, bu yüzden yapışkan telefon çalışmaya devam eder. */
    overflow-x: clip;
  }
  .features__head {
    display: grid;
    justify-items: start;
    gap: 18px;
  }
  .features__head .lead {
    max-width: 560px;
  }

  .story {
    --glow: rgba(124, 92, 245, 0.55);
    transition: --glow 0.9s var(--ease-out);
  }
  .story[data-active='test'] { --glow: rgba(79, 209, 165, 0.45); }
  .story[data-active='chat'] { --glow: rgba(110, 140, 255, 0.55); }
  .story[data-active='story'] { --glow: rgba(242, 196, 90, 0.42); }
  .story[data-active='translate'] { --glow: rgba(70, 200, 230, 0.42); }
  .story[data-active='speak'] { --glow: rgba(255, 107, 129, 0.42); }

  /* ---------- Adım metni ---------- */
  .step__text {
    position: relative;
    max-width: 520px;
  }
  /* Değişken yazı tipinde konturlar üst üste bindiği için dış çizgi yerine
     yukarıdan aşağı solan dolgu kullanılır. */
  .step__num {
    display: block;
    width: fit-content;
    font: 700 clamp(64px, 9vw, 112px) / 0.9 var(--font-display);
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, rgba(169, 150, 255, 0.55) 0%, rgba(169, 150, 255, 0.04) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 14px;
  }
  .step__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font: 700 13px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .step__kicker :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .step__title {
    margin-top: 14px;
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }
  .step__body {
    margin-top: 16px;
    color: var(--text-2);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.75;
  }
  .step__chips-label {
    margin-top: 22px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .step__chips {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .step__chips-label + .step__chips {
    margin-top: 10px;
  }
  .step__chips li {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
    background: rgba(19, 30, 84, 0.55);
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
  }

  /* ---------- Mobil / tablet: her adımın kendi telefonu ---------- */
  .story__visual {
    display: none;
  }
  .step {
    display: grid;
    justify-items: center;
    gap: 44px;
    padding-block: 72px;
  }
  .step__text {
    justify-self: stretch;
  }
  .step__phone {
    position: relative;
  }
  .step__phone::before {
    content: '';
    position: absolute;
    inset: 10% -20%;
    background: radial-gradient(closest-side, rgba(124, 92, 245, 0.45), transparent);
    filter: blur(30px);
    z-index: -1;
  }
  .step__phone :global(.phone) {
    --pw: min(290px, 74vw);
  }

  /* ---------- Masaüstü: yapışkan telefon ---------- */
  @media (min-width: 1000px) {
    .story {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(40px, 6vw, 110px);
    }
    .step {
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding-block: 0;
    }
    .step__phone {
      display: none;
    }
    .step__text {
      opacity: 0.28;
      transform: translateY(16px);
      transition: opacity 0.6s var(--ease-out), transform 0.8s var(--ease-out);
    }
    .step.is-active .step__text {
      opacity: 1;
      transform: none;
    }

    .story__visual {
      display: block;
      position: relative;
    }
    .story__sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      align-items: center;
      gap: 28px;
    }
    .story__glow {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 640px;
      height: 640px;
      margin: -320px 0 0 -350px;
      border-radius: 50%;
      background: radial-gradient(closest-side, var(--glow), transparent);
      filter: blur(40px);
      opacity: 0.85;
      pointer-events: none;
    }
    .story__sticky :global(.story__phone) {
      --pw: min(310px, calc((100svh - 150px) * 0.4615));
    }
    /* Yapışkan telefonda yalnızca aktif ekran görünür. */
    .story__sticky :global(.screen) {
      opacity: 0;
      transform: scale(0.965);
      transition: opacity 0.55s var(--ease-out), transform 0.7s var(--ease-out);
    }
    .story__sticky :global(.screen.is-active) {
      opacity: 1;
      transform: none;
    }

    .story__dots {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 14px;
    }
    .story__dots a {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid var(--border-soft);
      color: var(--muted);
      font: 700 11px/1 var(--font-body);
      transition: all 0.4s var(--ease-out);
    }
    .story[data-active='words'] [data-dot='words'] a,
    .story[data-active='test'] [data-dot='test'] a,
    .story[data-active='chat'] [data-dot='chat'] a,
    .story[data-active='story'] [data-dot='story'] a,
    .story[data-active='translate'] [data-dot='translate'] a,
    .story[data-active='speak'] [data-dot='speak'] a {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--ink);
      transform: scale(1.12);
    }
  }

  /* Bölüm ekran dışındayken telefon animasyonları durur. */
  .story:not(.in-view) :global(.screen *),
  .story:not(.in-view) :global(.screen *::before),
  .story:not(.in-view) :global(.screen *::after) {
    animation-play-state: paused !important;
  }
</style>
