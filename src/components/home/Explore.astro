---
/**
 * Keşfet: Kelime Paketleri, Video ile Öğren ve Gelişim Raporu. Her satır görünür alana
 * girince data-play → .is-playing alır ve telefon ekranı oynar; kaydırdıkça
 * telefon hafifçe döner (data-progress="through" → --p). Video satırında
 * telefon döngü içinde yan çevrilir ve video tam ekrana geçer.
 */
import Icon from '../Icon.astro';
import Phone from '../phone/Phone.astro';
import PacksScreen from '../phone/screens/PacksScreen.astro';
import VideoScreen from '../phone/screens/VideoScreen.astro';
import ReportScreen from '../phone/screens/ReportScreen.astro';

const rows = [
  {
    id: 'packs',
    Screen: PacksScreen,
    icon: 'inventory-2-rounded',
    kicker: 'Kelime Paketleri',
    title: 'Seviyene uygun kelimeler, tek dokunuşla havuzunda.',
    text: 'A1’den C2’ye her seviye için hazırlanmış kelime paketleri, senin seviyenle açılır. Kelimenin telaffuzunu dinle, beğendiğini tek dokunuşla havuzuna ekle; havuzunda zaten varsa uygulama seni uyarır. Eklediğin kelime ilk tekrarında karşına çıkar.',
    chips: ['6 seviye', 'Seviyenle açılır', 'Sesli telaffuz', 'Tek dokunuşla ekle'],
    label: 'Kelime Paketleri ekranı: B1 seviyesi açılıyor ve bir kelime havuza ekleniyor',
  },
  {
    id: 'video',
    Screen: VideoScreen,
    icon: 'play-circle-rounded',
    kicker: 'Video ile Öğren',
    title: 'İzle, dinle, kulağını İngilizceye alıştır.',
    text: 'Dinleme pratiği için seçilmiş İngilizce videoları uygulamadan çıkmadan izle. Telefonu yan çevirdiğinde video tam ekrana geçer, dik tuttuğunda geri döner. Yeni videolar eklendikçe liste kendiliğinden güncellenir.',
    chips: ['Seçilmiş videolar', 'Uygulama içinde izle', 'Yan çevir, tam ekran'],
    label: 'Video ile Öğren ekranı: video açılıyor ve tam ekrana geçiyor',
  },
  {
    id: 'report',
    Screen: ReportScreen,
    icon: 'insights',
    kicker: 'Gelişim Raporu',
    title: 'Gelişimini her hafta daha net gör.',
    text: '“Bu hafta” kartında çalıştığın günler alevle işaretlenir, serini ve en uzun serini görürsün. Altında öğrendiğin kelimeler, havuzundakiler, çözdüğün testler ve doğru oranın; en altta son 10 testinin başarı grafiği var. Geçmiş testlerini sıralayabilir, istemediğini kaydırarak silebilirsin.',
    chips: ['Haftalık seri', '4 özet kartı', 'Son 10 test grafiği'],
    label: 'Gelişim Raporu ekranı: haftalık seri, özet kartları ve test grafiği',
  },
];
---
<section class="explore section" id="kesfet" aria-labelledby="explore-title">
  <div class="container">
    <div class="explore__head">
      <p class="kicker" data-reveal>Keşfet</p>
      <h2 id="explore-title" class="title-lg" data-reveal style="--d:0.08s">
        Hazır kelimeler, <span class="text-gold">gerçek İngilizce.</span>
      </h2>
      <p class="lead" data-reveal style="--d:0.16s">
        Seviyene göre hazırlanmış paketlerle kelime havuzunu doldur, seçilmiş videolarla kulağını İngilizceye alıştır, gelişimini haftadan haftaya izle.
      </p>
    </div>

    {rows.map((r, i) => (
      <article class:list={['ex', `ex--${r.id}`, { 'ex--rev': i % 2 === 1 }]} data-play data-progress="through">
        <div class="ex__text" data-reveal>
          <p class="ex__kicker"><Icon name={r.icon} /> {r.kicker}</p>
          <h3 class="ex__title">{r.title}</h3>
          <p class="ex__body">{r.text}</p>
          <ul class="ex__chips">
            {r.chips.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        <div class="ex__stage" data-reveal="scale" style="--d:0.12s">
          <span class="ex__ring ex__ring--1" aria-hidden="true"></span>
          <span class="ex__ring ex__ring--2" aria-hidden="true"></span>
          <span class="ex__ring ex__ring--3" aria-hidden="true"></span>
          <span class="ex__glow" aria-hidden="true"></span>

          {r.id === 'packs' ? (
            <>
              <span class="fl fl--1" style="--depth:1.2" aria-hidden="true">
                <span class="fl__card"><b>achieve</b><span>başarmak</span></span>
              </span>
              <span class="fl fl--2" style="--depth:-0.8" aria-hidden="true">
                <span class="fl__lvl">C1</span>
              </span>
              <span class="fl fl--3" style="--depth:0.7" aria-hidden="true">
                <span class="fl__pill fl__pill--ok"><Icon name="add-task-rounded" /> Havuza eklendi</span>
              </span>
              <span class="fl fl--4" style="--depth:-1.1" aria-hidden="true">
                <span class="fl__lvl fl__lvl--sm">A2</span>
              </span>
            </>
          ) : r.id === 'report' ? (
            <>
              <span class="fl fl--1" style="--depth:1.1" aria-hidden="true">
                <span class="fl__pill fl__pill--fire"><Icon name="local-fire-department-rounded" /> 4 gün seri</span>
              </span>
              <span class="fl fl--2" style="--depth:-0.9" aria-hidden="true">
                <span class="fl__lvl">%82</span>
              </span>
              <span class="fl fl--3" style="--depth:0.8" aria-hidden="true">
                <span class="fl__pill fl__pill--ok"><Icon name="trending-up-rounded" /> Ortalama yükseliyor</span>
              </span>
            </>
          ) : (
            <>
              <span class="fl fl--1" style="--depth:1" aria-hidden="true">
                <span class="fl__pill"><Icon name="screen-rotation-rounded" /> Yan çevir · tam ekran</span>
              </span>
              <span class="fl fl--2" style="--depth:-0.9" aria-hidden="true">
                <span class="fl__play"><Icon name="play-arrow-rounded" /></span>
              </span>
              <span class="fl fl--3" style="--depth:0.8" aria-hidden="true">
                <span class="fl__pill fl__pill--eq"><span class="eq"><i></i><i></i><i></i><i></i></span> Dinleme pratiği</span>
              </span>
            </>
          )}

          <div class="ex__tilt">
            <div class="ex__spin">
              <Phone label={r.label}>
                <r.Screen />
              </Phone>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .explore {
    overflow-x: clip;
  }
  .explore__head {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(40px, 6vw, 72px);
  }

  .ex {
    --pw: min(262px, 66vw);
    --p: 0.5;
    display: grid;
    gap: 40px;
    align-items: center;
    padding-block: clamp(40px, 6vw, 80px);
  }
  .ex__text {
    max-width: 520px;
  }
  .ex__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-text);
    font: 700 13px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .ex__kicker :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .ex__title {
    margin-top: 14px;
    font-size: clamp(1.85rem, 3.4vw, 2.7rem);
  }
  .ex__body {
    margin-top: 16px;
    color: var(--text-2);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.75;
  }
  .ex__chips {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ex__chips li {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
    background: var(--panel);
    font-size: 14px;
    font-weight: 600;
  }

  /* ---------- Sahne ---------- */
  .ex__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(var(--pw) * 2.1667 + 40px);
  }
  .ex__stage :global(.phone) {
    --pw: inherit;
  }
  .ex__glow {
    position: absolute;
    width: calc(var(--pw) * 2);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(124, 92, 245, 0.5), transparent);
    filter: blur(30px);
    opacity: var(--glow-mul);
    pointer-events: none;
  }
  .ex--report .ex__glow {
    background: radial-gradient(closest-side, rgba(240, 146, 43, 0.3), rgba(79, 209, 165, 0.2) 55%, transparent);
  }
  .ex--video .ex__glow {
    background: radial-gradient(closest-side, rgba(255, 140, 120, 0.38), rgba(124, 92, 245, 0.22) 55%, transparent);
  }
  /* Sonar halkaları: ahtapotun yaşadığı derinliklere gönderme */
  .ex__ring {
    position: absolute;
    width: calc(var(--pw) * 1.75);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--line-ghost);
    pointer-events: none;
  }
  .ex__ring--2 {
    width: calc(var(--pw) * 2.3);
    border-style: dashed;
    border-color: var(--line-ghost);
  }
  .ex__ring--3 {
    width: calc(var(--pw) * 1.2);
    border-color: rgba(242, 196, 90, 0.16);
  }
  .is-playing .ex__ring--2 {
    animation: ex-turn 60s linear infinite;
  }
  .is-playing .ex__ring--1,
  .is-playing .ex__ring--3 {
    animation: ex-sonar 5s ease-in-out infinite alternate;
  }
  .is-playing .ex__ring--3 {
    animation-delay: -2.5s;
  }

  /* Kaydırdıkça hafif üç boyutlu dönüş; video satırında yön tersine. */
  .ex__tilt {
    position: relative;
    z-index: 2;
    --dir: 1;
    transform: perspective(1400px) rotateY(calc((var(--p) - 0.5) * -28deg * var(--dir)))
      rotateX(calc((var(--p) - 0.5) * 10deg)) translateY(calc((var(--p) - 0.5) * -30px));
    will-change: transform;
  }
  .ex--rev .ex__tilt {
    --dir: -1;
  }

  /* ---------- Yüzen parçalar ---------- */
  .fl {
    position: absolute;
    z-index: 3;
    transform: translateY(calc((var(--p) - 0.5) * -140px * var(--depth)));
    pointer-events: none;
  }
  .fl > * {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .is-playing .fl > * {
    animation: ex-bob 6s ease-in-out infinite alternate;
  }
  .is-playing .fl--2 > * { animation-delay: -1.5s; }
  .is-playing .fl--3 > * { animation-delay: -3s; }
  .is-playing .fl--4 > * { animation-delay: -4.5s; }

  .fl__card {
    flex-direction: column;
    align-items: flex-start !important;
    gap: 2px !important;
    padding: 12px 18px;
    border-radius: 18px;
    border: 1px solid var(--hover-border);
    background: var(--panel-strong);
    box-shadow: var(--float-shadow), 0 0 30px -10px rgba(124, 92, 245, calc(0.6 * var(--glow-mul)));
    backdrop-filter: blur(10px);
  }
  .fl__card b {
    font: 700 19px/1.1 var(--font-display);
  }
  .fl__card span {
    color: var(--primary-light);
    font-size: 14px;
    font-weight: 600;
  }
  .fl__lvl {
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: #fff;
    font: 900 18px/1 var(--font-body);
    box-shadow: 0 0 0 6px rgba(124, 92, 245, 0.16), 0 14px 34px -8px rgba(124, 92, 245, 0.9);
  }
  .fl__lvl--sm {
    width: 44px;
    height: 44px;
    font-size: 14px;
    opacity: 0.85;
  }
  .fl__pill {
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
    background: var(--panel-strong);
    box-shadow: var(--float-shadow);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    backdrop-filter: blur(10px);
  }
  .fl__pill :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--accent-text);
  }
  .fl__pill--fire {
    border-color: rgba(240, 146, 43, 0.5);
  }
  .fl__pill--fire :global(.icon) {
    color: #f0922b;
  }
  .fl__pill--ok {
    border-color: rgba(79, 209, 165, 0.45);
  }
  .fl__pill--ok :global(.icon) {
    color: var(--success);
  }
  .fl__play {
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--grad-gold);
    color: var(--ink);
    box-shadow: 0 0 0 8px rgba(242, 196, 90, 0.14), 0 16px 40px -10px rgba(242, 196, 90, 0.8);
  }
  .fl__play :global(.icon) {
    width: 34px;
    height: 34px;
  }
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
    transform-origin: bottom;
    transform: scaleY(0.4);
  }
  .is-playing .eq i {
    animation: ex-eq 0.9s ease-in-out infinite alternate;
  }
  .is-playing .eq i:nth-child(2) { animation-delay: -0.3s; }
  .is-playing .eq i:nth-child(3) { animation-delay: -0.6s; }
  .is-playing .eq i:nth-child(4) { animation-delay: -0.45s; }

  /* Konumlar (telefonun etrafında) */
  .ex--packs .fl--1 { left: 0; top: 16%; }
  .ex--packs .fl--2 { right: 2%; top: 10%; }
  .ex--packs .fl--3 { right: 0; bottom: 16%; }
  .ex--packs .fl--4 { left: 6%; bottom: 10%; }
  .ex--report .fl--1 { left: 2%; top: 14%; }
  .ex--report .fl--2 { right: 4%; top: 24%; }
  .ex--report .fl--3 { right: 0; bottom: 14%; }
  .ex--video .fl--1 { right: 0; top: 12%; }
  .ex--video .fl--2 { left: 2%; top: 30%; }
  .ex--video .fl--3 { left: 0; bottom: 14%; }

  /* ---------- Video satırı: telefon yan çevrilir (12 sn, ekranla eş zamanlı) ---------- */
  .ex--video {
    /* Yatay telefonun genişliği (boy × ölçek) ekrana sığsın. */
    --land-scale: 0.6;
  }
  .ex--video.is-playing .ex__spin {
    animation: ex-rotate 12s var(--ease-in-out) infinite;
  }

  @media (max-width: 999px) {
    .ex--packs .fl--1 { left: -4px; top: 6%; }
    .ex--packs .fl--3 { right: -4px; bottom: 8%; }
    .fl__card b { font-size: 16px; }
    .fl__pill { font-size: 12.5px; padding: 8px 12px; }
    .fl__lvl { width: 48px; height: 48px; font-size: 15px; }
    .fl__lvl--sm { width: 38px; height: 38px; font-size: 12px; }
    .fl__play { width: 52px; height: 52px; }
  }

  /* Dar ekranda yazılı etiketler telefonun üstüne biner; yalnızca küçük rozetler kalır. */
  @media (max-width: 599px) {
    .fl--1,
    .fl--3 {
      display: none;
    }
  }

  @media (min-width: 1000px) {
    .ex {
      --pw: 282px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(40px, 6vw, 100px);
    }
    .ex--rev .ex__text {
      order: 2;
    }
    .ex__stage {
      min-height: calc(var(--pw) * 2.1667 + 80px);
    }
    .ex--video {
      --land-scale: 0.74;
    }
  }

  @keyframes ex-rotate {
    0%, 33% { transform: none; }
    40%, 74% { transform: rotate(-90deg) scale(var(--land-scale)); }
    81%, 100% { transform: none; }
  }
  @keyframes ex-turn {
    to { transform: rotate(360deg); }
  }
  @keyframes ex-sonar {
    from { transform: scale(0.94); opacity: 0.5; }
    to { transform: scale(1.04); opacity: 1; }
  }
  @keyframes ex-bob {
    from { transform: translateY(-8px) rotate(-1.5deg); }
    to { transform: translateY(8px) rotate(1.5deg); }
  }
  @keyframes ex-eq {
    to { transform: scaleY(1); }
  }

  /* Ekran dışındayken hiçbir şey oynamaz (data-play .is-playing'i kaldırır). */
  @media (prefers-reduced-motion: reduce) {
    .ex__tilt,
    .fl {
      transform: none;
    }
    .ex *,
    .ex .ex__spin {
      animation: none !important;
    }
  }
</style>
