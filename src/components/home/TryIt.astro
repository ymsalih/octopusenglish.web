---
/**
 * Kendin dene: ziyaretçinin kullanabildiği çalışan bir telefon. Uygulamadaki
 * kurallarla aynı davranır (lib/screens/test_screen.dart, word_learning_screen.dart,
 * video_practice_screen.dart): kart dokununca çevrilir; sola kaydırma
 * "Hatırladım", sağa "Unuttum", yukarı "Öğrendim". Paketten eklenen kelime
 * havuza girer ve testte ilk sırada gelir. Hiçbir şey kaydedilmez; sayfa
 * yenilenince her şey baştan başlar. Videolar temsilidir (VideoScene).
 *
 * Kartlar ve listeler JS ile üretildiği için stiller is:global ve hepsi
 * .try / .demo önekiyle yazıldı.
 */
import Icon from '../Icon.astro';
import Phone from '../phone/Phone.astro';
import StatusBar from '../phone/StatusBar.astro';
import VideoScene from '../phone/VideoScene.astro';
import { levels, videos } from '../../data/demo';

const tabs = [
  {
    id: 'test',
    label: 'Test',
    icon: 'quiz-rounded',
    title: 'Kartı çevir, kaydır',
    hint: 'Karta dokunup çevir. Hatırladıysan sola, unuttuysan sağa, tamamen öğrendiysen yukarı kaydır.',
  },
  {
    id: 'packs',
    label: 'Paketler',
    icon: 'inventory-2-rounded',
    title: 'Paketten kelime ekle',
    hint: 'Bir seviye seç, kelimeyi dinle, yeşil düğmeyle havuzuna ekle. Testte ilk o gelir.',
  },
  {
    id: 'words',
    label: 'Kelimeler',
    icon: 'style-rounded',
    title: 'Havuzuna göz at',
    hint: 'Eklediğin kelimeler burada birikir; hoparlöre dokunup telaffuzunu dinle.',
  },
  {
    id: 'video',
    label: 'Video',
    icon: 'play-circle-rounded',
    title: 'Video aç, yan çevir',
    hint: 'Bir videoya dokun, sonra tam ekran düğmesiyle telefonu yan çevir.',
  },
];
const iconNames = ['volume-up-rounded', 'add-task-rounded', 'check-rounded', 'check-circle-rounded', 'info-rounded', 'touch-app-rounded', 'school-rounded', 'close-rounded'];
---
<section class="try section" id="dene" aria-labelledby="try-title">
  <div class="container try__grid">
    <div class="try__head">
      <p class="kicker" data-reveal>Kendin dene</p>
      <h2 id="try-title" class="title-lg" data-reveal style="--d:0.08s">
        Uygulamayı <span class="text-gold">elinde hisset.</span>
      </h2>
      <p class="lead" data-reveal style="--d:0.16s">
        Bu telefon gerçekten çalışıyor. Kartları çevir ve kaydır, paketlerden kelime ekle, bir videoyu tam ekranda aç.
      </p>
    </div>

    <div class="try__list" data-reveal style="--d:0.2s">
      <ol class="try__tabs">
        {tabs.map((t, i) => (
          <li>
            <button type="button" class="try__tab" data-go={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="try__tab-icon"><Icon name={t.icon} /></span>
              <span class="try__tab-text">
                <b>{t.title}</b>
                <span>{t.hint}</span>
              </span>
            </button>
          </li>
        ))}
      </ol>
      <p class="try__note">
        <Icon name="info-rounded" />
        <span>Bu bir tanıtım simülasyonudur: kelimeler uygulamadaki paketlerden örnektir, videolar temsilidir ve hiçbir şey kaydedilmez.</span>
      </p>
    </div>

    <div class="try__stage" data-try-stage data-reveal="scale" style="--d:0.1s">
      <span class="try__glow" aria-hidden="true"></span>
      <div class="try__spin">
        <Phone interactive label="Octopus English deneme telefonu">
          <div class="demo is-paused" data-demo data-tab="test">
            <StatusBar />

            <div class="views">
              {/* ---------- Test ---------- */}
              <section class="view is-on" data-view="test" aria-label="Kelime testi">
                <div class="d-ab"><span>Öğrenme Zamanı</span></div>
                <div class="t-progress">
                  <span class="t-bar"><span data-t-bar></span></span>
                  <span class="t-count" data-t-count>1/5</span>
                </div>
                <div class="t-deck" data-deck></div>
                <p class="t-hint">Karta dokun: çevir · Kaydır veya butonları kullan</p>
                <div class="t-actions">
                  <button type="button" class="t-act t-act--ok" data-verdict="remembered">
                    <span><Icon name="check-rounded" /></span>Hatırladım
                  </button>
                  <button type="button" class="t-act t-act--gold" data-verdict="mastered">
                    <span><Icon name="school-rounded" /></span>Öğrendim
                  </button>
                  <button type="button" class="t-act t-act--bad" data-verdict="forgot">
                    <span><Icon name="close-rounded" /></span>Unuttum
                  </button>
                </div>

                <div class="t-panel" data-result hidden>
                  <div class="t-ring"><b data-r-rate>%0</b><span>BAŞARI</span></div>
                  <p class="t-panel__title">Test Tamamlandı!</p>
                  <p class="t-panel__sub">İşte bu çalışmadaki performans analizin</p>
                  <ul class="t-stats">
                    <li class="ok"><b data-r-ok>0</b>Hatırladım</li>
                    <li class="gold"><b data-r-gold>0</b>Öğrendim</li>
                    <li class="bad"><b data-r-bad>0</b>Unuttum</li>
                  </ul>
                  <button type="button" class="d-btn" data-restart>Tekrar Test Et</button>
                </div>

                <div class="t-panel" data-t-empty hidden>
                  <span class="t-empty-icon"><Icon name="school-rounded" /></span>
                  <p class="t-panel__title">Hepsini öğrendin!</p>
                  <p class="t-panel__sub">Havuzunda tekrar edecek kelime kalmadı. Paketlerden yeni kelimeler ekle.</p>
                  <button type="button" class="d-btn" data-go="packs">Kelime Paketleri</button>
                </div>
              </section>

              {/* ---------- Kelime Paketleri ---------- */}
              <section class="view" data-view="packs" aria-label="Kelime paketleri" inert>
                <div class="d-ab"><span>Kelime Paketleri</span></div>
                <div class="p-levels">
                  {levels.map((l) => (
                    <button type="button" class="p-lv" data-level={l} aria-pressed={l === 'B1' ? 'true' : 'false'}>{l}</button>
                  ))}
                </div>
                <ul class="p-list" data-pack-list></ul>
              </section>

              {/* ---------- Kelime Havuzum ---------- */}
              <section class="view" data-view="words" aria-label="Kelime havuzum" inert>
                <div class="d-ab">
                  <span>Kelime Havuzum</span>
                  <span class="ph-pill"><Icon name="style-rounded" /> <span data-pool-count>6</span></span>
                </div>
                <p class="w-learned" data-learned hidden></p>
                <ul class="w-list" data-pool-list></ul>
              </section>

              {/* ---------- Video ile Öğren ---------- */}
              <section class="view" data-view="video" aria-label="Video ile öğren" inert>
                <div class="d-ab"><span>İngilizce Dinleme & Pratik</span></div>
                <div class="v-list">
                  {videos.map((v, i) => (
                    <button type="button" class="v-card" data-video={i} aria-label={`${v.title} videosunu aç`}>
                      <span class="v-thumb">
                        <VideoScene tone={v.tone} />
                        <span class="v-shade"></span>
                        <span class="v-play"><Icon name="play-arrow-rounded" /></span>
                      </span>
                      <span class="v-info">
                        <span class="v-yt"><Icon name="smart-display-rounded" /> YouTube</span>
                        <b>{v.title}</b>
                        <span>{v.desc}</span>
                      </span>
                    </button>
                  ))}
                </div>

                <div class="v-player" data-player hidden>
                  <div class="v-player__bar">
                    <button type="button" class="v-icon-btn" data-close-player aria-label="Video listesine dön">
                      <Icon name="arrow-back-rounded" />
                    </button>
                    <span data-player-title></span>
                  </div>
                  <div class="v-player__body">
                    <div class="v-video">
                      <VideoScene live class="is-paused" />
                      <button type="button" class="v-big" data-toggle aria-label="Oynat veya duraklat">
                        <Icon name="play-arrow-rounded" class="ic-play" />
                        <Icon name="pause-rounded" class="ic-pause" />
                      </button>
                      <span class="v-prog"><span data-prog></span></span>
                    </div>
                    <div class="v-controls">
                      <button type="button" class="v-icon-btn" data-toggle aria-label="Oynat veya duraklat">
                        <Icon name="play-arrow-rounded" class="ic-play" />
                        <Icon name="pause-rounded" class="ic-pause" />
                      </button>
                      <span class="v-time" data-time>0:00 / 0:00</span>
                      <button type="button" class="v-icon-btn v-fs" data-fullscreen aria-label="Tam ekran: telefonu yan çevir">
                        <Icon name="fullscreen-rounded" />
                      </button>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <nav class="d-tabs" aria-label="Deneme telefonu menüsü">
              {tabs.map((t, i) => (
                <button type="button" class:list={['d-tab', { 'is-on': i === 0 }]} data-go={t.id}>
                  <span class="d-tab__icon"><Icon name={t.icon} /></span>
                  <span class="d-tab__label">{t.label}</span>
                </button>
              ))}
              <span class="d-tabs__home"></span>
            </nav>

            <div class="d-snack" data-snack role="status" aria-live="polite"></div>

            {/* Tam ekran (yatay). Telefon -90° döner, bu katman +90° döner. */}
            <div class="d-land" data-land>
              <div class="d-land__video">
                <VideoScene live class="is-paused" />
                <button type="button" class="v-big" data-toggle aria-label="Oynat veya duraklat">
                  <Icon name="play-arrow-rounded" class="ic-play" />
                  <Icon name="pause-rounded" class="ic-pause" />
                </button>
                <div class="d-land__ctl">
                  <button type="button" class="v-icon-btn" data-toggle aria-label="Oynat veya duraklat">
                    <Icon name="play-arrow-rounded" class="ic-play" />
                    <Icon name="pause-rounded" class="ic-pause" />
                  </button>
                  <span class="v-prog v-prog--inline"><span data-prog></span></span>
                  <span class="v-time" data-time>0:00 / 0:00</span>
                  <button type="button" class="v-icon-btn" data-fullscreen-exit aria-label="Tam ekrandan çık">
                    <Icon name="fullscreen-exit-rounded" />
                  </button>
                </div>
              </div>
            </div>
          </div>
        </Phone>
      </div>
    </div>
  </div>

  <template data-icons>
    {iconNames.map((n) => <span data-i={n}><Icon name={n} /></span>)}
  </template>
</section>

<script>
  import { packs, starterPool, videos, type Level, type DemoWord } from '../../data/demo';

  type Word = DemoWord & { seen: number };
  type Verdict = 'remembered' | 'mastered' | 'forgot';

  const demo = document.querySelector<HTMLElement>('[data-demo]');
  const stage = document.querySelector<HTMLElement>('[data-try-stage]');
  const iconTpl = document.querySelector<HTMLTemplateElement>('template[data-icons]');

  if (demo && stage && iconTpl) {
    const $ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = demo) => el.querySelector<T>(sel)!;
    const $$ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = demo) => Array.from(el.querySelectorAll<T>(sel));
    const icon = (name: string) => iconTpl.content.querySelector(`[data-i="${name}"] svg`)!.cloneNode(true) as SVGElement;
    const h = (tag: string, cls = '', text = '') => {
      const el = document.createElement(tag);
      if (cls) el.className = cls;
      if (text) el.textContent = text;
      return el;
    };

    // Havuz: "seen" küçük olan kelime testte önce gelir (uygulamada en uzun
    // süredir tekrar edilmeyen önce gelir; yeni eklenen hiç tekrar edilmemiştir).
    const pool: Word[] = starterPool.map((w, i) => ({ ...w, seen: i + 1 }));
    let learned = 0;
    const inPool = (eng: string) => pool.some((w) => w.eng.toLowerCase() === eng.toLowerCase());

    /* ---------- Ortak: ses ve bildirim ---------- */

    const speak = (text: string) => {
      if (!('speechSynthesis' in window)) return;
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'en-US';
      u.rate = 0.9;
      speechSynthesis.speak(u);
    };

    const snack = $('[data-snack]');
    let snackTimer = 0;
    const showSnack = (text: string, ok = true) => {
      snack.replaceChildren(icon(ok ? 'check-circle-rounded' : 'info-rounded'), h('span', '', text));
      snack.classList.toggle('is-info', !ok);
      snack.classList.add('is-on');
      clearTimeout(snackTimer);
      snackTimer = window.setTimeout(() => snack.classList.remove('is-on'), 2000);
    };

    /* ---------- Sekmeler ---------- */

    const go = (id: string) => {
      if (demo.dataset.tab !== id) {
        if (demo.dataset.tab === 'video') leaveVideo();
        demo.dataset.tab = id;
        $$('[data-view]').forEach((v) => {
          const on = v.dataset.view === id;
          v.classList.toggle('is-on', on);
          v.toggleAttribute('inert', !on);
        });
        $$('.d-tab').forEach((t) => t.classList.toggle('is-on', t.dataset.go === id));
      }
      document.querySelectorAll<HTMLElement>('.try__tab').forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.go === id)));
      if (id === 'test' && (finished || !session.length)) startTest();
      if (id === 'words') renderPool();
    };
    document.querySelectorAll<HTMLElement>('#dene [data-go]').forEach((b) => b.addEventListener('click', () => go(b.dataset.go!)));

    /* ---------- Test ---------- */

    const deck = $('[data-deck]');
    const result = $('[data-result]');
    const empty = $('[data-t-empty]');
    let session: Word[] = [];
    let index = 0;
    let finished = false;
    let busy = false;
    let coached = false;
    const counts: Record<Verdict, number> = { remembered: 0, mastered: 0, forgot: 0 };

    const verdictUi: Record<Verdict, { label: string; icon: string; cls: string }> = {
      remembered: { label: 'Hatırladım', icon: 'check-rounded', cls: 'ok' },
      mastered: { label: 'Öğrendim', icon: 'school-rounded', cls: 'gold' },
      forgot: { label: 'Unuttum', icon: 'close-rounded', cls: 'bad' },
    };

    function startTest() {
      session = [...pool].sort((a, b) => a.seen - b.seen).slice(0, 5);
      index = 0;
      finished = false;
      busy = false;
      counts.remembered = counts.mastered = counts.forgot = 0;
      result.hidden = true;
      empty.hidden = session.length > 0;
      demo.classList.toggle('t-done', session.length === 0);
      renderDeck();
    }

    function renderDeck() {
      deck.replaceChildren();
      const total = session.length;
      $('[data-t-count]').textContent = `${Math.min(index + 1, total)}/${total}`;
      $('[data-t-bar]').style.width = `${total ? (index / total) * 100 : 0}%`;
      for (let k = Math.min(index + 2, total - 1); k >= index; k--) deck.append(makeCard(session[k], k - index));
    }

    function makeCard(w: Word, depth: number) {
      const card = h('div', 't-card');
      card.style.setProperty('--depth', String(depth));
      const inner = h('div', 't-card__inner');
      const front = h('div', 't-face t-face--front');
      const speakBtn = h('button', 't-speak');
      speakBtn.setAttribute('type', 'button');
      speakBtn.setAttribute('aria-label', `${w.eng} telaffuzunu dinle`);
      speakBtn.append(icon('volume-up-rounded'));
      speakBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        speak(w.eng);
      });
      speakBtn.addEventListener('pointerdown', (e) => e.stopPropagation());
      const touch = h('span', 't-touch');
      touch.append(icon('touch-app-rounded'));
      front.append(h('span', 't-lang', 'İngilizce'), speakBtn, h('span', 't-word', w.eng), touch);
      const back = h('div', 't-face t-face--back');
      back.append(h('span', 't-lang', 'Türkçe'), h('span', 't-word', w.tr));
      inner.append(front, back);
      const overlay = h('div', 't-verdict');
      card.append(inner, overlay);

      if (depth === 0) {
        card.tabIndex = 0;
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', `Kart: ${w.eng}. Çevirmek için dokun ya da Enter'a bas.`);
        attachDrag(card, overlay);
        card.addEventListener('keydown', (e) => {
          const map: Record<string, Verdict> = { ArrowLeft: 'remembered', ArrowUp: 'mastered', ArrowRight: 'forgot' };
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            flip(card);
          } else if (map[e.key]) {
            e.preventDefault();
            decide(map[e.key]);
          }
        });
        if (!coached) {
          const coach = h('span', 't-coach');
          coach.append(icon('touch-app-rounded'));
          card.append(coach);
        }
      }
      return card;
    }

    const stopCoach = () => {
      coached = true;
      deck.querySelector('.t-coach')?.remove();
    };

    function flip(card: HTMLElement) {
      stopCoach();
      card.classList.toggle('is-flipped');
    }

    function setOverlay(overlay: HTMLElement, v: Verdict | null, strength: number) {
      if (!v) {
        overlay.style.opacity = '0';
        return;
      }
      const ui = verdictUi[v];
      if (overlay.dataset.v !== v) {
        overlay.dataset.v = v;
        overlay.className = `t-verdict t-verdict--${ui.cls}`;
        overlay.replaceChildren(icon(ui.icon), h('span', '', ui.label));
      }
      overlay.style.opacity = String(Math.min(1, strength));
    }

    // Eşikler uygulamadakiyle aynı orandadır (göstermek 40/50, karar 80 birim),
    // kart genişliğine göre ölçeklenir.
    function readSwipe(dx: number, dy: number, unit: number): [Verdict | null, number, boolean] {
      if (dy < -50 * unit && Math.abs(dy) > Math.abs(dx)) return ['mastered', Math.abs(dy) / (150 * unit), dy < -80 * unit];
      if (dx > 40 * unit) return ['forgot', dx / (150 * unit), dx > 80 * unit];
      if (dx < -40 * unit) return ['remembered', -dx / (150 * unit), dx < -80 * unit];
      return [null, 0, false];
    }

    function attachDrag(card: HTMLElement, overlay: HTMLElement) {
      let sx = 0;
      let sy = 0;
      let dx = 0;
      let dy = 0;
      let down = false;
      let moved = false;
      const unit = () => card.offsetWidth / 300;

      card.addEventListener('pointerdown', (e) => {
        if (busy) return;
        down = true;
        moved = false;
        sx = e.clientX;
        sy = e.clientY;
        dx = dy = 0;
        card.setPointerCapture(e.pointerId);
        card.classList.add('is-dragging');
        stopCoach();
      });
      card.addEventListener('pointermove', (e) => {
        if (!down) return;
        dx = e.clientX - sx;
        dy = e.clientY - sy;
        if (Math.hypot(dx, dy) > 6) moved = true;
        card.style.transform = `translate(${dx}px, ${dy}px) rotate(${(25 * dx) / card.offsetWidth}deg)`;
        const [v, s] = readSwipe(dx, dy, unit());
        setOverlay(overlay, v, s);
      });
      const end = () => {
        if (!down) return;
        down = false;
        card.classList.remove('is-dragging');
        if (!moved) {
          card.style.transform = '';
          flip(card);
          return;
        }
        const [v, , commit] = readSwipe(dx, dy, unit());
        if (v && commit) {
          decide(v);
        } else {
          card.style.transform = '';
          setOverlay(overlay, null, 0);
        }
      };
      card.addEventListener('pointerup', end);
      card.addEventListener('pointercancel', end);
    }

    function decide(v: Verdict) {
      const card = deck.querySelector<HTMLElement>('.t-card:last-child');
      if (busy || finished || !card) return;
      busy = true;
      stopCoach();
      const overlay = card.querySelector<HTMLElement>('.t-verdict')!;
      setOverlay(overlay, v, 1);
      const W = card.offsetWidth * 2.4;
      const off = v === 'mastered' ? `translate(0, ${-card.offsetHeight * 2.4}px)` : `translate(${v === 'forgot' ? W : -W}px, 0) rotate(${v === 'forgot' ? 30 : -30}deg)`;
      card.classList.add('is-leaving');
      card.style.transform = off;

      const w = session[index];
      counts[v]++;
      w.seen = Date.now() + index;
      if (v === 'mastered') {
        const at = pool.indexOf(w);
        if (at >= 0) pool.splice(at, 1);
        learned++;
      }

      window.setTimeout(() => {
        index++;
        busy = false;
        if (index >= session.length) finish();
        else renderDeck();
      }, 360);
    }

    function finish() {
      finished = true;
      deck.replaceChildren();
      $('[data-t-bar]').style.width = '100%';
      const correct = counts.remembered + counts.mastered;
      const rate = Math.round((correct / session.length) * 100);
      $('[data-r-ok]').textContent = String(counts.remembered);
      $('[data-r-gold]').textContent = String(counts.mastered);
      $('[data-r-bad]').textContent = String(counts.forgot);
      result.hidden = false;
      demo.classList.add('t-done');
      const ring = $('.t-ring', result);
      const rateEl = $('[data-r-rate]', result);
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / 900);
        const v = Math.round(rate * (1 - Math.pow(1 - p, 3)));
        ring.style.setProperty('--v', String(v));
        rateEl.textContent = `%${v}`;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    $$('[data-verdict]').forEach((b) => b.addEventListener('click', () => decide(b.dataset.verdict as Verdict)));
    $('[data-restart]').addEventListener('click', startTest);

    /* ---------- Kelime Paketleri ---------- */

    const packList = $('[data-pack-list]');
    let level: Level = 'B1';

    function renderPack() {
      packList.replaceChildren();
      packs[level].forEach((w, i) => {
        const li = h('li', 'p-item');
        li.style.setProperty('--i', String(i));
        const txt = h('span', 'p-txt');
        txt.append(h('b', '', w.eng), h('span', '', w.tr));
        const sp = h('button', 'p-btn p-btn--sp');
        sp.setAttribute('type', 'button');
        sp.setAttribute('aria-label', `${w.eng} telaffuzunu dinle`);
        sp.append(icon('volume-up-rounded'));
        sp.addEventListener('click', () => speak(w.eng));
        const add = h('button', 'p-btn p-btn--add');
        add.setAttribute('type', 'button');
        add.setAttribute('aria-label', `${w.eng} kelimesini havuza ekle`);
        const added = inPool(w.eng);
        add.classList.toggle('is-added', added);
        add.append(icon(added ? 'check-rounded' : 'add-task-rounded'));
        add.addEventListener('click', () => {
          if (inPool(w.eng)) {
            showSnack('Bu kelime zaten havuzunda.', false);
            return;
          }
          pool.unshift({ ...w, seen: -Date.now() });
          add.classList.add('is-added', 'is-pop');
          add.replaceChildren(icon('check-rounded'));
          showSnack(`“${w.eng}” başarıyla havuza eklendi!`);
          if (finished) startTest();
        });
        li.append(h('span', 'p-badge', level), txt, sp, add);
        packList.append(li);
      });
    }

    $$('[data-level]').forEach((b) =>
      b.addEventListener('click', () => {
        level = b.dataset.level as Level;
        $$('[data-level]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        renderPack();
      }),
    );

    /* ---------- Kelime Havuzum ---------- */

    function renderPool() {
      const list = $('[data-pool-list]');
      list.replaceChildren();
      $('[data-pool-count]').textContent = String(pool.length);
      const learnedEl = $('[data-learned]');
      learnedEl.hidden = learned === 0;
      learnedEl.textContent = `Öğrendiklerim: ${learned} kelime`;
      if (!pool.length) {
        list.append(h('li', 'w-empty', 'Havuzun boş. Paketlerden kelime ekle.'));
        return;
      }
      pool.forEach((w) => {
        const li = h('li', 'w-item');
        const txt = h('span', 'w-txt');
        txt.append(h('b', '', w.eng), h('span', '', w.tr));
        const sp = h('button', 'w-sp');
        sp.setAttribute('type', 'button');
        sp.setAttribute('aria-label', `${w.eng} telaffuzunu dinle`);
        sp.append(icon('volume-up-rounded'));
        sp.addEventListener('click', () => speak(w.eng));
        li.append(txt, sp);
        list.append(li);
      });
    }

    /* ---------- Video ---------- */

    const player = $('[data-player]');
    const scenes = $$('.v-video .vs, .d-land .vs');
    let duration = 0;
    let time = 0;
    let playing = false;
    let last = 0;

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const paint = () => {
      $$('[data-prog]').forEach((p) => (p.style.width = `${duration ? (time / duration) * 100 : 0}%`));
      $$('[data-time]').forEach((t) => (t.textContent = `${fmt(time)} / ${fmt(duration)}`));
    };
    const loop = (now: number) => {
      if (!playing) return;
      time = Math.min(duration, time + (now - last) / 1000);
      last = now;
      paint();
      if (time >= duration) setPlaying(false);
      else requestAnimationFrame(loop);
    };
    function setPlaying(on: boolean) {
      if (on && time >= duration) time = 0;
      playing = on;
      demo.classList.toggle('is-paused', !on);
      scenes.forEach((s) => s.classList.toggle('is-paused', !on));
      if (on) {
        last = performance.now();
        requestAnimationFrame(loop);
      }
    }

    function openVideo(i: number) {
      const v = videos[i];
      $('[data-player-title]').textContent = v.title;
      scenes.forEach((s) => {
        s.classList.remove('vs--sunset', 'vs--ocean', 'vs--dawn');
        s.classList.add(`vs--${v.tone}`);
      });
      duration = v.length;
      time = 0;
      paint();
      player.hidden = false;
      setPlaying(true);
    }
    function setLand(on: boolean) {
      if (on) {
        const phone = stage!.querySelector<HTMLElement>('.phone')!;
        const scale = Math.min(0.92, (stage!.clientWidth - 12) / phone.offsetHeight);
        stage!.style.setProperty('--land-scale', scale.toFixed(3));
      }
      stage!.classList.toggle('is-land', on);
    }
    function leaveVideo() {
      setPlaying(false);
      setLand(false);
    }

    $$('[data-video]').forEach((b) => b.addEventListener('click', () => openVideo(Number(b.dataset.video))));
    $$('[data-toggle]').forEach((b) => b.addEventListener('click', () => setPlaying(!playing)));
    $('[data-close-player]').addEventListener('click', () => {
      leaveVideo();
      player.hidden = true;
    });
    $('[data-fullscreen]').addEventListener('click', () => setLand(true));
    $('[data-fullscreen-exit]').addEventListener('click', () => setLand(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && stage.classList.contains('is-land')) setLand(false);
    });

    // Bölüm ekrandan çıkınca video durur ve telefon dik konuma döner.
    new IntersectionObserver(([e]) => {
      if (!e.isIntersecting && demo.dataset.tab === 'video') leaveVideo();
    }).observe(stage);

    startTest();
    renderPack();
    renderPool();
  }
</script>

