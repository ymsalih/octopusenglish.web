---
/**
 * Temsili video karesi: gün batımında bir şehir silueti, sürüklenen bulutlar
 * ve sudan geçen bir yelkenli. Gerçek bir video ya da YouTube görseli değildir.
 * Boyutunu kapsayıcısından alır (16:9). "live" ise bulutlar ve tekne hareket
 * eder; .is-paused sınıfı hareketi dondurur. Tonu JS ile de değiştirilebilir
 * (vs--sunset / vs--ocean / vs--dawn).
 */
import type { VideoTone } from '../../data/demo';

interface Props {
  tone?: VideoTone;
  live?: boolean;
  class?: string;
}
const { tone = 'sunset', live = false, class: className } = Astro.props;
---
<div class:list={['vs', `vs--${tone}`, { 'vs--live': live }, className]} aria-hidden="true">
  <span class="vs__sun"></span>
  <span class="vs__cloud vs__cloud--1"></span>
  <span class="vs__cloud vs__cloud--2"></span>
  <svg class="vs__city" viewBox="0 0 160 90" preserveAspectRatio="xMidYMax slice">
    <path
      class="vs__far"
      d="M0 70V58h10v-6h8v8h9v-12h7v10h12v-8h10v14h8v-9h11v-6h9v9h10v-12h8v12h12v-6h9v10h17V70Z"
    />
    <path
      class="vs__near"
      d="M0 70V52h8v-8h6v12h7V38h4v-4h4v4h4v22h8V48h10v10h6V30h3v-4h2v4h3v32h9V50h7v-8h8v16h6V46h5v-6h5v6h4v14h9v-6h8V44h7v20h9v-8h18v14Z"
    />
    <g class="vs__lights">
      <rect x="24" y="42" width="1.6" height="1.6" />
      <rect x="28" y="48" width="1.6" height="1.6" />
      <rect x="24" y="54" width="1.6" height="1.6" />
      <rect x="62" y="34" width="1.6" height="1.6" />
      <rect x="66" y="40" width="1.6" height="1.6" />
      <rect x="62" y="48" width="1.6" height="1.6" />
      <rect x="66" y="56" width="1.6" height="1.6" />
      <rect x="83" y="46" width="1.6" height="1.6" />
      <rect x="112" y="44" width="1.6" height="1.6" />
      <rect x="116" y="52" width="1.6" height="1.6" />
      <rect x="140" y="50" width="1.6" height="1.6" />
    </g>
    <rect class="vs__water" x="0" y="70" width="160" height="20" />
    <g class="vs__waves">
      <rect x="10" y="74" width="22" height="0.7" rx="0.35" />
      <rect x="58" y="78" width="30" height="0.7" rx="0.35" />
      <rect x="108" y="75" width="18" height="0.7" rx="0.35" />
      <rect x="30" y="83" width="26" height="0.7" rx="0.35" />
      <rect x="96" y="85" width="34" height="0.7" rx="0.35" />
    </g>
    <g class="vs__boat">
      <path d="M0 76.4h9l-1.6 2.2H1.4Z" />
      <path d="M4.6 75.8V67l4 8.8Z" class="vs__sail" />
    </g>
  </svg>
</div>

<style>
  .vs {
    --sky1: #2b1a5e;
    --sky2: #8a3f8f;
    --sky3: #ff9a6b;
    --sun: #ffd38a;
    --far: #3a2470;
    --city: #1a1240;
    --water: #2a1d5a;
    --light: #ffd88a;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: linear-gradient(180deg, var(--sky1) 0%, var(--sky2) 52%, var(--sky3) 78%);
    container-type: inline-size;
  }
  .vs--ocean {
    --sky1: #071034;
    --sky2: #1f3b8a;
    --sky3: #3fa3c9;
    --sun: #eef4ff;
    --far: #14286a;
    --city: #081030;
    --water: #0d1d4f;
    --light: #9fe0ff;
  }
  .vs--dawn {
    --sky1: #3a2a7a;
    --sky2: #c06aa8;
    --sky3: #ffc6a0;
    --sun: #fff0c2;
    --far: #5a3a8a;
    --city: #2a1a55;
    --water: #3a2b6e;
    --light: #fff2c4;
  }

  .vs__sun {
    position: absolute;
    left: 58%;
    top: 30%;
    width: 17%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 6cqw 2cqw color-mix(in srgb, var(--sun) 55%, transparent);
  }
  .vs__cloud {
    position: absolute;
    height: 5%;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.35);
    filter: blur(0.4cqw);
  }
  .vs__cloud--1 {
    left: 8%;
    top: 18%;
    width: 26%;
  }
  .vs__cloud--2 {
    left: 66%;
    top: 12%;
    width: 18%;
    opacity: 0.7;
  }
  .vs__city {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .vs__far {
    fill: var(--far);
  }
  .vs__near {
    fill: var(--city);
  }
  .vs__lights rect {
    fill: var(--light);
    opacity: 0.85;
  }
  .vs__water {
    fill: var(--water);
  }
  .vs__waves rect {
    fill: color-mix(in srgb, var(--sun) 60%, transparent);
  }
  .vs__boat {
    fill: var(--city);
    transform: translateX(20px);
  }
  .vs__sail {
    fill: color-mix(in srgb, var(--sun) 75%, white);
  }

  .vs--live .vs__cloud--1 { animation: vs-drift 16s linear infinite; }
  .vs--live .vs__cloud--2 { animation: vs-drift 22s linear infinite -8s; }
  .vs--live .vs__boat { animation: vs-boat 18s linear infinite; }
  .vs--live .vs__waves rect { animation: vs-wave 3s ease-in-out infinite alternate; }
  .vs--live .vs__lights rect:nth-child(3n) { animation: vs-blink 2.4s steps(1) infinite; }
  .vs--live .vs__sun { animation: vs-sun 9s ease-in-out infinite alternate; }
  .vs.is-paused *,
  .vs.is-paused {
    animation-play-state: paused !important;
  }

  @keyframes vs-drift {
    from { transform: translateX(-120cqw); }
    to { transform: translateX(120cqw); }
  }
  @keyframes vs-boat {
    from { transform: translateX(-12px); }
    to { transform: translateX(170px); }
  }
  @keyframes vs-wave {
    from { transform: translateX(-3px); opacity: 0.4; }
    to { transform: translateX(3px); opacity: 1; }
  }
  @keyframes vs-blink {
    50% { opacity: 0.15; }
  }
  @keyframes vs-sun {
    to { transform: translateY(12%); }
  }
</style>
