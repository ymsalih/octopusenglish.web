---
/**
 * Telefon çerçevesi. İçindeki ekranlar boyutlarını "cqw" (ekran genişliğinin
 * yüzdesi) ile verir; böylece telefon hangi boyutta çizilirse çizilsin
 * arayüz orantılı kalır.
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label = 'Octopus English uygulamasından bir ekran' } = Astro.props;
---
<div class:list={['phone', className]} role="img" aria-label={label}>
  <div class="phone__frame">
    <div class="phone__island" aria-hidden="true"></div>
    <div class="phone__screen">
      <slot />
    </div>
  </div>
</div>

<style>
  .phone {
    --pw: 300px;
    position: relative;
    width: var(--pw);
    aspect-ratio: 9 / 19.5;
    flex-shrink: 0;
  }
  .phone__frame {
    position: absolute;
    inset: 0;
    padding: calc(var(--pw) * 0.034);
    border-radius: calc(var(--pw) * 0.165);
    background: linear-gradient(150deg, #2c3676 0%, #0c1132 38%, #0a0f2c 62%, #232c66 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      inset 0 0 0 calc(var(--pw) * 0.012) #070b24,
      0 0 0 1.5px rgba(120, 140, 230, 0.35),
      0 50px 90px -30px rgba(0, 0, 0, 0.85),
      0 30px 120px -40px rgba(124, 92, 245, 0.55);
  }
  .phone__island {
    position: absolute;
    z-index: 30;
    top: calc(var(--pw) * 0.062);
    left: 50%;
    width: 30%;
    height: calc(var(--pw) * 0.085);
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }
  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--pw) * 0.135);
    background: linear-gradient(180deg, #17245c 0%, #0b1540 45%, #050920 100%);
    container-type: inline-size;
    color: var(--text);
    font-family: var(--font-body);
    -webkit-user-select: none;
    user-select: none;
  }
</style>
