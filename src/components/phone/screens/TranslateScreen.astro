---
/**
 * Kamerayla tarama (camera_scanner_screen.dart) + Akıllı Çeviri
 * (translation_screen.dart). Döngü: tabela taranır → metin bulunur →
 * çeviri ekranında anlam, sözcük türü, görsel ve örnek cümle gelir.
 */
import Icon from '../../Icon.astro';
import StatusBar from '../StatusBar.astro';
import AppBar from '../AppBar.astro';

interface Props {
  inline?: boolean;
}
const { inline = false } = Astro.props;
// Ekran sayfada iki kez çizilebildiği için (masaüstü + mobil) SVG kimlikleri benzersiz olmalı.
const uid = inline ? 'tr-i' : 'tr-s';
---
<div class="screen" data-screen="translate" data-screen-inline={inline ? '' : undefined}>
  <!-- 2. aşama: çeviri sonucu -->
  <div class="res">
    <StatusBar />
    <AppBar title="Akıllı Çeviri" back />
    <div class="res__body">
      <div class="dir r1">
        <span>İngilizce</span><Icon name="swap-horiz-rounded" /><span>Türkçe</span>
      </div>
      <div class="input r1">
        <span class="input__text">lighthouse</span>
        <span class="input__tools">
          <Icon name="volume-up-rounded" />
          <Icon name="photo-camera-rounded" />
          <Icon name="mic-rounded" />
        </span>
      </div>
      <div class="go r2">Akıllı Çeviri ✨</div>
      <div class="result r3">
        <svg class="illus" viewBox="0 0 240 104" aria-hidden="true">
          <defs>
            <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1b2868" />
              <stop offset="0.7" stop-color="#5a3f9e" />
              <stop offset="1" stop-color="#f2c45a" />
            </linearGradient>
            <linearGradient id={`${uid}-beam-r`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#ffe3a1" stop-opacity="0.85" />
              <stop offset="1" stop-color="#ffe3a1" stop-opacity="0" />
            </linearGradient>
            <linearGradient id={`${uid}-beam-l`} x1="1" y1="0" x2="0" y2="0">
              <stop offset="0" stop-color="#ffe3a1" stop-opacity="0.85" />
              <stop offset="1" stop-color="#ffe3a1" stop-opacity="0" />
            </linearGradient>
          </defs>
          <rect width="240" height="104" fill={`url(#${uid}-sky)`} />
          <g fill="#fff" opacity="0.7">
            <circle cx="30" cy="14" r="0.9" /><circle cx="70" cy="24" r="0.7" /><circle cx="190" cy="12" r="1" />
            <circle cx="214" cy="30" r="0.7" /><circle cx="150" cy="8" r="0.6" /><circle cx="104" cy="16" r="0.8" />
          </g>
          <g class="beam">
            <polygon points="150,38 240,20 240,56" fill={`url(#${uid}-beam-r)`} />
            <polygon points="150,38 60,20 60,56" fill={`url(#${uid}-beam-l)`} />
          </g>
          <path d="M0 84 Q30 79 60 84 T120 84 T180 84 T240 84 V104 H0Z" fill="#0b1540" />
          <path d="M0 92 Q30 87 60 92 T120 92 T180 92 T240 92 V104 H0Z" fill="#050920" />
          <polygon points="141,86 159,86 156,44 144,44" fill="#f4f1ff" />
          <polygon points="143.4,72 156.6,72 156,62 144,62" fill="#ff6b81" />
          <polygon points="144.6,56 155.4,56 155,48 145,48" fill="#ff6b81" />
          <rect x="143" y="34" width="14" height="10" rx="2" fill="#f2c45a" />
          <polygon points="141,34 159,34 150,26" fill="#26357a" />
        </svg>
        <div class="result__head">
          <span class="result__word">Deniz feneri</span>
          <Icon name="volume-up-rounded" />
        </div>
        <span class="type">İsim</span>
        <p class="means">deniz feneri · fener kulesi</p>
        <div class="example">
          <span class="ph-overline">Örnekler: Bağlam içi kullanım</span>
          <p>The lighthouse guided the ships home.</p>
          <p class="example__tr">Deniz feneri gemileri eve yönlendirdi.</p>
        </div>
      </div>
      <div class="add r4"><Icon name="add-rounded" /> Bu Kelimeyi Havuzuma Ekle</div>
    </div>
  </div>

  <!-- 1. aşama: kamera taraması -->
  <div class="cam">
    <div class="cam__photo">
      <span class="bokeh b1"></span><span class="bokeh b2"></span><span class="bokeh b3"></span>
      <div class="sign">
        <span class="sign__big">LIGHTHOUSE</span>
        <span class="sign__small">Open daily · 09:00 – 18:00</span>
      </div>
    </div>
    <StatusBar />
    <div class="cam__top">
      <Icon name="close-rounded" />
      <Icon name="flash-on-rounded" />
    </div>
    <div class="frame">
      <i></i><i></i><i></i><i></i>
      <span class="laser"></span>
    </div>
    <p class="cam__hint">Metni ekrana hizalayın veya Galeriden seçin</p>
    <div class="cam__bottom">
      <Icon name="image-rounded" />
      <span class="shutter"></span>
      <span class="spacer"></span>
    </div>
    <div class="found">
      <span class="ph-overline">Tespit Edilen Metin:</span>
      <span class="found__text">LIGHTHOUSE</span>
      <span class="found__btns"><span>İptal</span><span class="found__go">Çevir</span></span>
    </div>
  </div>
</div>

<style>
  .res,
  .cam {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  /* ----- Sonuç ----- */
  .res__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2.6cqw;
    padding: 0 5cqw 7cqw;
    overflow: hidden;
  }
  .dir {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3cqw;
    padding: 2.2cqw;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font: 700 3.5cqw/1 var(--font-body);
  }
  .dir :global(.icon) {
    width: 5cqw;
    height: 5cqw;
    color: var(--secondary);
  }
  .input {
    display: grid;
    gap: 3cqw;
    padding: 3.6cqw 4cqw;
    border-radius: 4cqw;
    border: 1px solid var(--border);
    background: rgba(19, 30, 84, 0.7);
  }
  .input__text {
    font-size: 4.8cqw;
    font-weight: 600;
  }
  .input__tools {
    display: flex;
    justify-content: flex-end;
    gap: 4cqw;
    color: var(--primary-light);
    font-size: 5cqw;
  }
  .go {
    display: grid;
    place-items: center;
    padding: 3.4cqw;
    border-radius: 4.6cqw;
    background: linear-gradient(90deg, var(--secondary), var(--primary));
    font: 700 4.2cqw/1 var(--font-body);
    letter-spacing: 0.02em;
  }
  .result {
    display: grid;
    gap: 1.6cqw;
    padding: 3.2cqw;
    border-radius: 4.6cqw;
    border: 1.5px solid rgba(159, 178, 255, 0.3);
    background: rgba(19, 30, 84, 0.7);
  }
  .illus {
    width: 100%;
    height: auto;
    border-radius: 3cqw;
  }
  .beam {
    transform-origin: 150px 38px;
  }
  .is-active .beam {
    animation: tr-beam 4s ease-in-out infinite alternate;
  }
  .result__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1cqw;
  }
  .result__word {
    font: 650 6.4cqw/1.1 var(--font-display);
  }
  .result__head :global(.icon) {
    width: 6cqw;
    height: 6cqw;
    color: var(--primary-light);
  }
  .type {
    justify-self: start;
    padding: 1.2cqw 2.6cqw;
    border-radius: 999px;
    background: rgba(159, 178, 255, 0.16);
    color: var(--secondary);
    font: 700 3cqw/1 var(--font-body);
  }
  .means {
    color: var(--text-2);
    font-size: 3.6cqw;
  }
  .example {
    display: grid;
    gap: 1cqw;
    padding-top: 2cqw;
    border-top: 1px solid var(--border);
    font-size: 3.4cqw;
  }
  .example__tr {
    color: var(--secondary);
  }
  .add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.4cqw;
    padding: 3.4cqw;
    border-radius: 4cqw;
    background: var(--primary);
    font: 700 3.7cqw/1 var(--font-body);
  }
  .add :global(.icon) {
    width: 5cqw;
    height: 5cqw;
  }

  /* ----- Kamera ----- */
  .cam {
    z-index: 2;
    background: #05060f;
    opacity: 0;
    visibility: hidden;
  }
  .cam__photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(60% 40% at 30% 20%, rgba(90, 120, 200, 0.35), transparent 70%),
      radial-gradient(70% 50% at 80% 90%, rgba(242, 196, 90, 0.18), transparent 70%),
      linear-gradient(180deg, #1a2140 0%, #0d1126 60%, #07091a 100%);
  }
  .bokeh {
    position: absolute;
    border-radius: 50%;
    filter: blur(2cqw);
    background: rgba(255, 220, 150, 0.35);
  }
  .b1 { width: 18cqw; height: 18cqw; left: 6cqw; top: 30cqw; }
  .b2 { width: 12cqw; height: 12cqw; right: 10cqw; top: 22cqw; background: rgba(160, 180, 255, 0.35); }
  .b3 { width: 24cqw; height: 24cqw; right: -4cqw; bottom: 40cqw; }
  .sign {
    position: absolute;
    left: 12cqw;
    right: 12cqw;
    top: 74cqw;
    display: grid;
    justify-items: center;
    gap: 2cqw;
    padding: 6cqw 3cqw;
    border-radius: 2.5cqw;
    background: linear-gradient(180deg, #2a3a6e, #1d2a57);
    border: 1.2cqw solid #c9d1ef;
    box-shadow: 0 4cqw 10cqw rgba(0, 0, 0, 0.6);
    transform: rotate(-4deg);
  }
  .sign__big {
    font: 700 8cqw/1 var(--font-body);
    letter-spacing: 0.06em;
    color: #f4f1ff;
  }
  .sign__small {
    font: 600 3.4cqw/1 var(--font-body);
    color: #c9d1ef;
  }
  .cam__top {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 0 5cqw;
    font-size: 6.4cqw;
  }
  .frame {
    position: absolute;
    left: 8cqw;
    right: 8cqw;
    top: 64cqw;
    height: 52cqw;
  }
  .frame i {
    position: absolute;
    width: 8cqw;
    height: 8cqw;
    border: 0 solid var(--accent);
  }
  .frame i:nth-child(1) { top: 0; left: 0; border-top-width: 1cqw; border-left-width: 1cqw; border-top-left-radius: 2.4cqw; }
  .frame i:nth-child(2) { top: 0; right: 0; border-top-width: 1cqw; border-right-width: 1cqw; border-top-right-radius: 2.4cqw; }
  .frame i:nth-child(3) { bottom: 0; left: 0; border-bottom-width: 1cqw; border-left-width: 1cqw; border-bottom-left-radius: 2.4cqw; }
  .frame i:nth-child(4) { bottom: 0; right: 0; border-bottom-width: 1cqw; border-right-width: 1cqw; border-bottom-right-radius: 2.4cqw; }
  .laser {
    position: absolute;
    left: 4cqw;
    right: 4cqw;
    top: 10%;
    height: 0.6cqw;
    border-radius: 1cqw;
    background: var(--accent);
    box-shadow: 0 0 4cqw 1cqw rgba(242, 196, 90, 0.6);
  }
  .cam__hint {
    position: absolute;
    left: 0;
    right: 0;
    top: 122cqw;
    text-align: center;
    font-size: 3.2cqw;
    color: rgba(244, 241, 255, 0.8);
  }
  .cam__bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12cqw;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    justify-items: center;
    font-size: 7cqw;
  }
  .shutter {
    width: 17cqw;
    height: 17cqw;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1.4cqw rgba(5, 6, 15, 1), 0 0 0 2.4cqw #fff;
  }
  .found {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 2.4cqw;
    padding: 6cqw 6cqw 10cqw;
    border-radius: 7cqw 7cqw 0 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    transform: translateY(110%);
  }
  .found__text {
    font: 700 6cqw/1 var(--font-display);
  }
  .found__btns {
    display: flex;
    justify-content: flex-end;
    gap: 3cqw;
    font: 700 3.8cqw/1 var(--font-body);
    color: var(--muted);
  }
  .found__btns span {
    padding: 2.8cqw 4.4cqw;
    border-radius: 999px;
  }
  .found__go {
    background: var(--primary);
    color: #fff;
  }

  /* ---- Döngü (11 sn) ---- */
  .is-active .cam { animation: tr-cam 11s linear infinite; }
  .is-active .laser { animation: tr-laser 11s var(--ease-in-out) infinite; }
  .is-active .frame { animation: tr-frame 11s var(--ease-out) infinite; }
  .is-active .found { animation: tr-found 11s var(--ease-out) infinite; }
  .is-active .found__go { animation: tr-go 11s var(--ease-out) infinite; }
  .is-active .r1 { animation: tr-in 11s var(--ease-out) infinite; }
  .is-active .r2 { animation: tr-in2 11s var(--ease-out) infinite; }
  .is-active .r3 { animation: tr-in3 11s var(--ease-out) infinite; }
  .is-active .r4 { animation: tr-in4 11s var(--ease-out) infinite; }

  @keyframes tr-cam {
    0%, 40% { opacity: 1; visibility: visible; }
    45%, 96% { opacity: 0; visibility: hidden; }
    100% { opacity: 1; visibility: visible; }
  }
  @keyframes tr-laser {
    0%, 3% { top: 8%; opacity: 0; }
    5% { opacity: 1; }
    13% { top: 88%; }
    21% { top: 8%; }
    27% { top: 50%; opacity: 1; }
    30%, 100% { top: 50%; opacity: 0; }
  }
  @keyframes tr-frame {
    0%, 26% { inset: 64cqw 8cqw auto 8cqw; height: 52cqw; }
    31%, 100% { inset: 80cqw 14cqw auto 14cqw; height: 18cqw; }
  }
  @keyframes tr-found {
    0%, 30% { transform: translateY(110%); }
    34%, 100% { transform: translateY(0); }
  }
  @keyframes tr-go {
    0%, 37% { transform: scale(1); }
    38.5% { transform: scale(0.9); filter: brightness(1.3); }
    40%, 100% { transform: scale(1); filter: none; }
  }
  @keyframes tr-in {
    0%, 42% { opacity: 0; transform: translateY(3cqw); }
    47%, 100% { opacity: 1; transform: none; }
  }
  @keyframes tr-in2 {
    0%, 45% { opacity: 0; transform: translateY(3cqw); }
    50% { opacity: 1; transform: none; }
    52% { transform: scale(0.96); }
    54%, 100% { opacity: 1; transform: none; }
  }
  @keyframes tr-in3 {
    0%, 55% { opacity: 0; transform: translateY(5cqw) scale(0.97); }
    61%, 100% { opacity: 1; transform: none; }
  }
  @keyframes tr-in4 {
    0%, 60% { opacity: 0; transform: translateY(3cqw); }
    65%, 100% { opacity: 1; transform: none; }
  }
  @keyframes tr-beam {
    from { transform: rotate(-10deg); }
    to { transform: rotate(10deg); }
  }
</style>
