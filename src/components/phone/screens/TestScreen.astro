---
/**
 * Kendini Test Et (lib/screens/test_screen.dart). Döngü: kart çevrilir ve
 * sola kayar (Hatırladım) → sonraki çevrilir ve yukarı kayar (Öğrendim) →
 * üçüncüsü sağa kayar (Unuttum).
 */
import Icon from '../../Icon.astro';
import StatusBar from '../StatusBar.astro';
import AppBar from '../AppBar.astro';
import BottomBar from '../BottomBar.astro';

interface Props {
  inline?: boolean;
}
const { inline = false } = Astro.props;

const cards = [
  { id: 'a', en: 'Persistent', tr: 'Azimli', verdict: 'Hatırladım', icon: 'check-rounded', tone: 'ok' },
  { id: 'b', en: 'Ubiquitous', tr: 'Her yerde bulunan', verdict: 'Öğrendim', icon: 'school-rounded', tone: 'gold' },
  { id: 'c', en: 'Reluctant', tr: 'İsteksiz', verdict: 'Unuttum', icon: 'close-rounded', tone: 'bad' },
];
---
<div class="screen" data-screen="test" data-screen-inline={inline ? '' : undefined}>
  <StatusBar />
  <AppBar title="Öğrenme Zamanı">
    <span slot="right" class="ph-pill"><Icon name="quiz-rounded" /> 12/40</span>
  </AppBar>

  <div class="progress">
    <span class="bar"><span></span></span>
    <span class="count">
      <span class="n n1">3/10</span><span class="n n2">4/10</span><span class="n n3">5/10</span><span class="n n4">6/10</span>
    </span>
  </div>

  <div class="deck">
    {[...cards].reverse().map((c) => (
      <div class:list={['card', `card--${c.id}`]}>
        <div class="card__inner">
          <div class="face face--front">
            <span class="face__lang">İngilizce</span>
            <Icon name="volume-up-rounded" class="face__speak" />
            <span class="face__word">{c.en}</span>
            <Icon name="touch-app-rounded" class="face__touch" />
          </div>
          <div class="face face--back">
            <span class="face__lang">Türkçe</span>
            <span class="face__word">{c.tr}</span>
          </div>
        </div>
        <div class:list={['verdict', `verdict--${c.tone}`]}>
          <Icon name={c.icon} />
          <span>{c.verdict}</span>
        </div>
      </div>
    ))}
  </div>

  <p class="hint">Karta dokun: çevir · Kaydır veya butonları kullan</p>

  <div class="actions">
    <span class="act act--ok"><span class="act__btn"><Icon name="check-rounded" /></span>Hatırladım</span>
    <span class="act act--gold"><span class="act__btn"><Icon name="school-rounded" /></span>Öğrendim</span>
    <span class="act act--bad"><span class="act__btn"><Icon name="close-rounded" /></span>Unuttum</span>
  </div>

  <BottomBar active="test" />
</div>

<style>
  .progress {
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding: 1cqw 5cqw 0;
  }
  .bar {
    flex: 1;
    height: 2.2cqw;
    border-radius: 2cqw;
    background: var(--surface-high);
    overflow: hidden;
  }
  .bar span {
    display: block;
    width: 30%;
    height: 100%;
    border-radius: inherit;
    background: var(--primary-light);
  }
  .count {
    display: inline-grid;
    color: var(--text-2);
    font-weight: 700;
    font-size: 3.6cqw;
  }
  .n {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .n1 {
    opacity: 1;
  }

  .deck {
    position: relative;
    flex: 1;
    perspective: 220cqw;
  }
  .card {
    position: absolute;
    left: 10cqw;
    right: 10cqw;
    top: 10cqw;
    height: 66cqw;
    transform-origin: 50% 100%;
  }
  .card--b {
    transform: translateY(5cqw) scale(0.94);
    filter: brightness(0.72);
  }
  .card--c {
    transform: translateY(10cqw) scale(0.88);
    filter: brightness(0.5);
  }
  .card__inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 6cqw;
    border-radius: 7cqw;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 6cqw 12cqw -4cqw rgba(124, 92, 245, 0.45);
  }
  .face--front {
    background: linear-gradient(135deg, #6d4df0 0%, #8e7bff 55%, #9fb2ff 100%);
    color: #fff;
  }
  .face--back {
    background: var(--surface-high);
    border: 1.5px solid rgba(169, 150, 255, 0.5);
    transform: rotateY(180deg);
  }
  .face__lang {
    position: absolute;
    top: 5cqw;
    left: 5.5cqw;
    font: 800 2.9cqw/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .face--back .face__lang {
    color: var(--muted);
    opacity: 1;
  }
  .face__word {
    font: 650 8.4cqw/1.1 var(--font-display);
    text-align: center;
  }
  .face :global(.face__speak) {
    position: absolute;
    top: 3.5cqw;
    right: 4cqw;
    width: 6.4cqw;
    height: 6.4cqw;
  }
  .face :global(.face__touch) {
    position: absolute;
    bottom: 4cqw;
    left: 50%;
    width: 5.6cqw;
    height: 5.6cqw;
    margin-left: -2.8cqw;
    opacity: 0.35;
  }

  .verdict {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5cqw;
    border-radius: 7cqw;
    color: #fff;
    font: 650 7.4cqw/1 var(--font-display);
    opacity: 0;
  }
  .verdict :global(.icon) {
    width: 14cqw;
    height: 14cqw;
  }
  .verdict--ok { background: rgba(21, 129, 95, 0.92); }
  .verdict--gold { background: rgba(178, 116, 20, 0.92); }
  .verdict--bad { background: rgba(217, 63, 88, 0.92); }

  .hint {
    text-align: center;
    font-size: 3.2cqw;
    color: var(--muted);
    margin-bottom: 3cqw;
  }
  .actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0 5cqw 4cqw;
  }
  .act {
    display: grid;
    justify-items: center;
    gap: 1.6cqw;
    font: 700 3.1cqw/1 var(--font-body);
  }
  .act__btn {
    display: grid;
    place-items: center;
    width: 15cqw;
    height: 15cqw;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-size: 7cqw;
  }
  .act--ok { color: var(--success); }
  .act--gold { color: var(--accent); }
  .act--bad { color: var(--danger); }
  .act--ok .act__btn { background: rgba(79, 209, 165, 0.14); border-color: rgba(79, 209, 165, 0.4); }
  .act--gold .act__btn { background: rgba(242, 196, 90, 0.14); border-color: rgba(242, 196, 90, 0.4); }
  .act--bad .act__btn { background: rgba(255, 107, 129, 0.14); border-color: rgba(255, 107, 129, 0.4); }

  /* ---- Döngü (9 sn) ---- */
  .is-active .card--a { animation: t-a 9s var(--ease-in-out) infinite; }
  .is-active .card--a .card__inner { animation: t-flip-a 9s var(--ease-in-out) infinite; }
  .is-active .card--a .verdict { animation: t-v-a 9s linear infinite; }
  .is-active .card--b { animation: t-b 9s var(--ease-in-out) infinite; }
  .is-active .card--b .card__inner { animation: t-flip-b 9s var(--ease-in-out) infinite; }
  .is-active .card--b .verdict { animation: t-v-b 9s linear infinite; }
  .is-active .card--c { animation: t-c 9s var(--ease-in-out) infinite; }
  .is-active .card--c .verdict { animation: t-v-c 9s linear infinite; }
  .is-active .act--ok .act__btn { animation: t-press-a 9s var(--ease-out) infinite; }
  .is-active .act--gold .act__btn { animation: t-press-b 9s var(--ease-out) infinite; }
  .is-active .act--bad .act__btn { animation: t-press-c 9s var(--ease-out) infinite; }
  .is-active .bar span { animation: t-bar 9s var(--ease-out) infinite; }
  .is-active .n1 { animation: t-n1 9s linear infinite; }
  .is-active .n2 { animation: t-n2 9s linear infinite; }
  .is-active .n3 { animation: t-n3 9s linear infinite; }
  .is-active .n4 { animation: t-n4 9s linear infinite; }

  @keyframes t-flip-a {
    0%, 8% { transform: rotateY(0); }
    16%, 84% { transform: rotateY(180deg); }
    85%, 100% { transform: rotateY(0); }
  }
  @keyframes t-v-a {
    0%, 19% { opacity: 0; }
    24%, 30% { opacity: 1; }
    31%, 100% { opacity: 0; }
  }
  @keyframes t-a {
    0%, 22% { transform: none; opacity: 1; filter: none; }
    30% { transform: translate(-150%, 4%) rotate(-18deg); opacity: 0; }
    84% { transform: translate(0, -6%) scale(0.9); opacity: 0; }
    90%, 100% { transform: none; opacity: 1; filter: none; }
  }
  @keyframes t-b {
    0%, 30% { transform: translateY(5cqw) scale(0.94); filter: brightness(0.72); }
    35%, 50% { transform: none; opacity: 1; filter: none; }
    58% { transform: translate(0, -170%) scale(0.9); opacity: 0; }
    84% { transform: translateY(5cqw) scale(0.94); opacity: 0; }
    90%, 100% { transform: translateY(5cqw) scale(0.94); filter: brightness(0.72); }
  }
  @keyframes t-flip-b {
    0%, 37% { transform: rotateY(0); }
    45%, 84% { transform: rotateY(180deg); }
    85%, 100% { transform: rotateY(0); }
  }
  @keyframes t-v-b {
    0%, 47% { opacity: 0; }
    51%, 57% { opacity: 1; }
    58%, 100% { opacity: 0; }
  }
  @keyframes t-c {
    0%, 30% { transform: translateY(10cqw) scale(0.88); filter: brightness(0.5); }
    35%, 57% { transform: translateY(5cqw) scale(0.94); filter: brightness(0.72); }
    62%, 68% { transform: none; opacity: 1; filter: none; }
    76% { transform: translate(150%, 4%) rotate(18deg); opacity: 0; }
    84% { transform: translateY(10cqw) scale(0.88); opacity: 0; }
    90%, 100% { transform: translateY(10cqw) scale(0.88); filter: brightness(0.5); }
  }
  @keyframes t-v-c {
    0%, 65% { opacity: 0; }
    69%, 75% { opacity: 1; }
    76%, 100% { opacity: 0; }
  }
  @keyframes t-press-a {
    0%, 21% { transform: scale(1); }
    23% { transform: scale(0.86); box-shadow: 0 0 0 3cqw rgba(79, 209, 165, 0.25); }
    27%, 100% { transform: scale(1); box-shadow: none; }
  }
  @keyframes t-press-b {
    0%, 49% { transform: scale(1); }
    51% { transform: scale(0.86); box-shadow: 0 0 0 3cqw rgba(242, 196, 90, 0.25); }
    55%, 100% { transform: scale(1); box-shadow: none; }
  }
  @keyframes t-press-c {
    0%, 67% { transform: scale(1); }
    69% { transform: scale(0.86); box-shadow: 0 0 0 3cqw rgba(255, 107, 129, 0.25); }
    73%, 100% { transform: scale(1); box-shadow: none; }
  }
  @keyframes t-bar {
    0%, 29% { width: 30%; }
    32%, 57% { width: 40%; }
    60%, 75% { width: 50%; }
    78%, 94% { width: 60%; }
    100% { width: 30%; }
  }
  @keyframes t-n1 { 0%, 29% { opacity: 1; } 30%, 95% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes t-n2 { 0%, 29% { opacity: 0; } 30%, 57% { opacity: 1; } 58%, 100% { opacity: 0; } }
  @keyframes t-n3 { 0%, 57% { opacity: 0; } 58%, 75% { opacity: 1; } 76%, 100% { opacity: 0; } }
  @keyframes t-n4 { 0%, 75% { opacity: 0; } 76%, 95% { opacity: 1; } 100% { opacity: 0; } }
</style>
